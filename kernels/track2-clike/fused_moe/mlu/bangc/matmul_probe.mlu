/* Copyright (c) 2026 kernelswift authors.
 *
 * Minimal probe for __bang_matmul fp32 overload on MLU590.
 *
 * Goal: determine the WRAM layout expected by __bang_matmul(float*, const float*,
 * const float*, M, K, N). The underlying intrinsic __mlvm_stream_conv_f32_f32_f32
 * is a 1x1 conv, so src1 (the "kernel") likely expects [N, K] row-major (conv
 * kernel layout), NOT [K, N] (matmul layout). Also probe minimum tile dims.
 */

#include <bang.h>

#define M (64)
#define K (64)
#define N (64)

__mlu_global__ void MatmulProbe(float *src0, float *src1, float *dst,
                                int trans_en) {
  __nram__ float nram_a[M * K];
  __nram__ float nram_b_tmp[K * N];
  __wram__ float wram_b[K * N];
  __nram__ float nram_c[M * N];

  __memcpy(nram_a, src0, M * K * sizeof(float), GDRAM2NRAM);
  // __bang_load_matrix rejects GDRAM2WRAM. Stage via NRAM:
  //   GDRAM -> NRAM (plain memcpy), then NRAM -> WRAM (tiled matrix load).
  __memcpy(nram_b_tmp, src1, K * N * sizeof(float), GDRAM2NRAM);
  if (trans_en) {
    __bang_load_matrix(wram_b, nram_b_tmp, NRAM2WRAM, K, N, N, true);
  } else {
    __bang_load_matrix(wram_b, nram_b_tmp, NRAM2WRAM, K, N, N, false);
  }

  __bang_matmul(nram_c, nram_a, wram_b, M, K, N);

  __memcpy(dst, nram_c, M * N * sizeof(float), NRAM2GDRAM);
}

void policyFunc(cnrtDim3_t *dim, cnrtFunctionType_t *func_type) {
  *func_type = cnrtFuncTypeBlock;
  dim->x = 1;
  dim->y = 1;
  dim->z = 1;
}

extern "C" void launch_probe(float *src0, float *src1, float *dst,
                             int trans_en, cnrtQueue_t queue) {
  cnrtDim3_t dim;
  cnrtFunctionType_t func_type;
  policyFunc(&dim, &func_type);
  MatmulProbe<<<dim, func_type, queue>>>(src0, src1, dst, trans_en);
}
