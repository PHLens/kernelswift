/* Copyright (c) 2026 kernelswift authors.
 *
 * BangC fused MoE kernel for MLU590 (compute_50, mtp_592).
 *
 * Per-token program (grid=T, Union1 multicore). Each program:
 *   1. softmax(router_logits[token, :E]) -> scores [E] f32
 *   2. top-2 selection sort -> topk_ids[2], topk_vals[2]
 *   3. renorm topk_vals to sum=1
 *   4. for k in 0..K-1:
 *        gate_up = x @ w1_T[expert]            (M=1, K=H, N=2I)  -> f32 [2I]
 *        act     = silu(gate_up[:I]) * gate_up[I:]
 *        out_k   = act @ w2_T[expert]          (M=1, K=I, N=H)  -> f32 [H]
 *        accumulate out += topk_weights[k] * out_k
 *   5. store out[token, :H] as fp16
 *
 * w1_T and w2_T are host-side pre-transposed weight layouts:
 *   base.py: w1[E, 2I, H], w2[E, H, I]
 *   kernel expects: w1_T[E, H, 2I] (so src1=[K=H, N=2I] row-major)
 *                   w2_T[E, I, H] (so src1=[K=I, N=H] row-major)
 */

#include <bang.h>

#define H (128)
#define I (64)
#define TWO_I (128)
#define E (8)
#define K (2)

__mlu_global__ void FusedMoEKernel(
    half *hidden,           // [T, H]
    float *router_logits,   // [T, E]
    half *w1_T,             // [E, H, 2I]   (pre-transposed)
    half *w2_T,             // [E, I, H]    (pre-transposed)
    half *out,              // [T, H]
    int T) {
  // Per-program on-chip memory
  // All intermediates are fp32 — fp16 rounding in nram_gate_up_h/nram_act/
  // nram_out_k_h/nram_out_acc was the root cause of max_abs_diff=1.71 (relative
  // error ~0.1% but absolute > 5e-2 atol). Final cast to fp16 happens only at
  // the GDRAM store.
  __nram__ half nram_x[H];                 // 256 B
  __nram__ float nram_logits[E];           // 32 B
  __nram__ float nram_scores[E];           // 32 B
  __nram__ float nram_gate_up[TWO_I];      // 512 B  (GEMM1 out, fp32)
  __nram__ float nram_act[I];              // 256 B  (silu*up, fp32)
  __nram__ float nram_out_k[H];            // 512 B  (GEMM2 out, fp32)
  __nram__ float nram_out_acc[H];          // 512 B  (final accumulator, fp32)
  __nram__ half nram_out_h[H];             // 256 B  (final fp16 store buffer)
  // Weights live in NRAM (not WRAM) because we do scalar accumulation — WRAM
  // is for the dedicated matrix unit and does not support scalar reads.
  __nram__ half nram_w1[TWO_I * H];        // 32 KiB  ([K=H, N=2I] = 128*128)
  __nram__ half nram_w2[H * I];            // 16 KiB  ([K=I, N=H] = 64*128)

  int tid = taskId;
  int tdim = taskDim;

  for (int token = tid; token < T; token += tdim) {
    // 1. load hidden[token] and router_logits[token]
    __memcpy(nram_x, hidden + (size_t)token * H, H * sizeof(half), GDRAM2NRAM);
    __memcpy(nram_logits, router_logits + (size_t)token * E, E * sizeof(float),
             GDRAM2NRAM);

    // 2. softmax: max, sub, exp, sum, div
    float max_logit = nram_logits[0];
    for (int e = 1; e < E; ++e) {
      if (nram_logits[e] > max_logit) max_logit = nram_logits[e];
    }
    for (int e = 0; e < E; ++e) {
      nram_scores[e] = nram_logits[e] - max_logit;
    }
    // exp in-place on nram_scores
    // __bang_exp needs NRAM buffer; compute on the first E elements
    // (E=8 is tiny, scalar exp would also work but we route via bang intrinsic
    // using a wider buffer is overkill; scalar loop is acceptable here.)
    float sum_exp = 0.f;
    for (int e = 0; e < E; ++e) {
      // BangC scalar expf on host-side math: use the C math library
      // through the bang_device_functions.h wrappers. Use __ bang_expf?
      // The bang_device path exposes `expf` from <bang.h>'s cmath.
      nram_scores[e] = expf(nram_scores[e]);
      sum_exp += nram_scores[e];
    }
    float inv_sum = 1.f / sum_exp;
    for (int e = 0; e < E; ++e) {
      nram_scores[e] *= inv_sum;
    }

    // 3. top-2 selection sort
    int topk_ids[K];
    float topk_vals[K];

    // first argmax
    {
      int best = 0;
      float bestv = nram_scores[0];
      for (int e = 1; e < E; ++e) {
        if (nram_scores[e] > bestv) {
          bestv = nram_scores[e];
          best = e;
        }
      }
      topk_ids[0] = best;
      topk_vals[0] = bestv;
      nram_scores[best] = -1e30f;  // mask out
    }
    // second argmax
    {
      int best = 0;
      float bestv = nram_scores[0];
      for (int e = 1; e < E; ++e) {
        if (nram_scores[e] > bestv) {
          bestv = nram_scores[e];
          best = e;
        }
      }
      topk_ids[1] = best;
      topk_vals[1] = bestv;
    }

    // 4. renorm
    float wsum = topk_vals[0] + topk_vals[1];
    float w0 = topk_vals[0] / wsum;
    float w1 = topk_vals[1] / wsum;

    // zero accumulator (fp32 now, no half round-trip)
    for (int h = 0; h < H; ++h) nram_out_acc[h] = 0.f;

    // 5. per-expert GEMM loop
    for (int k = 0; k < K; ++k) {
      int eid = topk_ids[k];
      float wk = (k == 0) ? w0 : w1;

      // GEMM1 (manual scalar): gate_up[n] = sum_h x[h] * w1_T[eid, h, n]
      // w1_T is [E, H, 2I] row-major. w1 is loaded into NRAM as a flat
      // contiguous block; we read it scalar-wise since the
      // `__bang_matmul(float*, const half*, const half*, M, K, N)` overload
      // produced wrong output — its expected WRAM stride layout for half
      // inputs is undocumented (samples only cover int8 with 4D strided copy).
      __memcpy(nram_w1, w1_T + (size_t)eid * H * TWO_I,
               H * TWO_I * sizeof(half), GDRAM2NRAM);
      for (int n = 0; n < TWO_I; ++n) {
        float acc = 0.f;
        for (int h = 0; h < H; ++h) {
          acc += (float)nram_x[h] * (float)nram_w1[h * TWO_I + n];
        }
        nram_gate_up[n] = acc;  // fp32, no cast
      }

      // silu(gate) * up  where gate = [..I], up = [I..2I)
      // silu(x) = x * sigmoid(x) = x / (1 + exp(-x))   — all fp32
      for (int i = 0; i < I; ++i) {
        float g = nram_gate_up[i];
        float u = nram_gate_up[i + I];
        float sig = 1.f / (1.f + expf(-g));
        nram_act[i] = g * sig * u;  // fp32, no cast
      }

      // GEMM2 (manual scalar): out_k[h] = sum_i act[i] * w2_T[eid, i, h]
      // w2_T is [E, I, H] row-major.
      __memcpy(nram_w2, w2_T + (size_t)eid * I * H,
               I * H * sizeof(half), GDRAM2NRAM);
      for (int h = 0; h < H; ++h) {
        float acc = 0.f;
        for (int i = 0; i < I; ++i) {
          acc += nram_act[i] * (float)nram_w2[i * H + h];  // act already fp32
        }
        nram_out_k[h] = acc;  // fp32, no cast
      }
      // weighted accumulate in fp32
      for (int h = 0; h < H; ++h) {
        nram_out_acc[h] += nram_out_k[h] * wk;
      }
    }

    // 6. final cast fp32 -> fp16 only at the GDRAM store boundary
    for (int h = 0; h < H; ++h) {
      nram_out_h[h] = (half)nram_out_acc[h];
    }
    __memcpy(out + (size_t)token * H, nram_out_h, H * sizeof(half),
             NRAM2GDRAM);
  }
}

void policyFunc(cnrtDim3_t *dim, cnrtFunctionType_t *func_type) {
  // Union1: 4 cores share one cluster's SRAM; x=4, y=8 -> 32 cores total
  *func_type = cnrtFuncTypeUnion1;
  dim->x = 4;
  dim->y = 8;
  dim->z = 1;
}

// BangC launch syntax <<<dim, func_type, queue>>> must be compiled by cncc
// (g++ cannot parse it). Expose a plain-C wrapper so host_driver.cpp can link.
extern "C" void launch_fused_moe(half *hidden, float *router_logits,
                                 half *w1_T, half *w2_T, half *out, int t_count,
                                 cnrtQueue_t queue) {
  cnrtDim3_t dim;
  cnrtFunctionType_t func_type;
  policyFunc(&dim, &func_type);
  FusedMoEKernel<<<dim, func_type, queue>>>(hidden, router_logits, w1_T, w2_T,
                                            out, t_count);
}
